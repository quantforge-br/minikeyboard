# Build artifacts
/target/
/build/
/stage/
/cargo-home/
*.pcapng

# Captures stay outside the repo by default
/captures/

# Editor / OS
*~
*.swp
.DS_Store

# Flatpak builder
/.flatpak-builder/
/build-dir/

# Local meson
/meson-private/
/meson-logs/

# Vendor binaries and reverse-engineering workspaces stay outside the repo
/linux/*.AppImage
/win/**/*.exe
/win/**/*.dll
/win/**/*.o
/win/targets/
/win/artifacts/

# Reverse-engineering scratch space and agent tooling stay local
/win/
/.pi/
/.agents/
/.claude/
/.codegraph/

# Build and packaging output
/builddir/
/dist/
*.AppImage
*.deb
*.rpm

# Python caches
__pycache__/
*.pyc

# Secrets and local environment
.env
.env.*
*.pem
*.key
